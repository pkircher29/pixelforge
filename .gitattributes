# Normalise line endings to LF in the repo (CI runs on Linux, macOS and Windows).
* text=auto eol=lf

# Windows-only files keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.icns binary
*.psd binary
*.pfproj binary
*.woff binary
*.woff2 binary
